<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/video_title" />
        <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/video_description" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="18dp" android:background="@color/navy">
            <VideoView android:id="@+id/video_view" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ProgressBar android:id="@+id/video_progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/video_status" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/video_waiting" />
        <Button android:id="@+id/video_load" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/video_load" />
    </LinearLayout>
</ScrollView>
