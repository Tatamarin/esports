<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/back_button" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back" android:src="@android:drawable/ic_media_previous" android:tint="@color/white" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/standings_title" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
        <Space android:layout_width="48dp" android:layout_height="1dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/standings_subtitle" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:baselineAligned="false" android:gravity="bottom" android:orientation="horizontal">
                <LinearLayout style="@style/PodiumCard" android:layout_height="132dp"><TextView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_rank_badge" android:gravity="center" android:text="@string/rank_2" android:textColor="@color/blue" android:textSize="18sp" android:textStyle="bold" /><TextView style="@style/PodiumTeam" android:text="@string/nova_squad" /><TextView style="@style/PodiumPoints" android:text="@string/points_15" /></LinearLayout>
                <LinearLayout style="@style/PodiumLeader"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/leader" android:textColor="#8A5D00" android:textSize="11sp" android:textStyle="bold" /><TextView android:layout_width="50dp" android:layout_height="50dp" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/medal_gold" android:textSize="32sp" /><TextView style="@style/PodiumTeam" android:text="@string/poli_titans" /><TextView style="@style/PodiumPoints" android:text="@string/points_18" /></LinearLayout>
                <LinearLayout style="@style/PodiumCard" android:layout_height="116dp"><TextView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_rank_badge" android:gravity="center" android:text="@string/rank_3" android:textColor="@color/blue" android:textSize="18sp" android:textStyle="bold" /><TextView style="@style/PodiumTeam" android:text="@string/byte_warriors" /><TextView style="@style/PodiumPoints" android:text="@string/points_12" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="0dp">
                <LinearLayout style="@style/TableHeaderRow"><TextView style="@style/RankCell" android:text="@string/table_position" /><TextView style="@style/TableTeamCellHeader" android:text="@string/table_team" /><TextView style="@style/TableCellHeader" android:text="@string/table_record" /><TextView style="@style/TableCellHeader" android:text="@string/table_points" /></LinearLayout>
                <LinearLayout style="@style/TableRow"><TextView style="@style/RankCell" android:text="@string/rank_1" /><TextView style="@style/TableTeamCell" android:text="@string/poli_titans" /><TextView style="@style/TableCell" android:text="@string/record_6_0" /><TextView style="@style/TablePoints" android:text="@string/value_18" /></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout style="@style/TableRow"><TextView style="@style/RankCell" android:text="@string/rank_2" /><TextView style="@style/TableTeamCell" android:text="@string/nova_squad" /><TextView style="@style/TableCell" android:text="@string/record_5_1" /><TextView style="@style/TablePoints" android:text="@string/value_15" /></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout style="@style/TableRow"><TextView style="@style/RankCell" android:text="@string/rank_3" /><TextView style="@style/TableTeamCell" android:text="@string/byte_warriors" /><TextView style="@style/TableCell" android:text="@string/record_4_2" /><TextView style="@style/TablePoints" android:text="@string/value_12" /></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout style="@style/TableRow"><TextView style="@style/RankCell" android:text="@string/rank_4" /><TextView style="@style/TableTeamCell" android:text="@string/campus_five" /><TextView style="@style/TableCell" android:text="@string/record_3_3" /><TextView style="@style/TablePoints" android:text="@string/value_9" /></LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/updated_now" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
