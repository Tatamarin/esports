<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TorneosESports" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BodyText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:minHeight">58dp</item>
    </style>
    <style name="DashboardCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:elevation">1dp</item>
    </style>
    <style name="SmallBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="OperationCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:elevation">1dp</item>
    </style>
    <style name="MenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/bg_menu_item</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@color/menu_text</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="StatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="GalleryCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">0dp</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="GalleryTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="GallerySubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">14dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="RecentEventCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:elevation">1dp</item>
    </style>
    <style name="RecentEventIcon">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/bg_edit_button</item>
        <item name="android:padding">11dp</item>
    </style>
    <style name="RecentEventTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="RecentEventSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="MatchCard"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">12dp</item><item name="android:background">@drawable/bg_card</item><item name="android:orientation">vertical</item><item name="android:elevation">2dp</item></style>
    <style name="TeamRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">58dp</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item></style>
    <style name="TeamName"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item></style>
    <style name="TeamScore"><item name="android:layout_width">40dp</item><item name="android:layout_height">40dp</item><item name="android:gravity">center</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item></style>
    <style name="TeamScoreWinner" parent="TeamScore"><item name="android:textColor">@color/blue</item></style>
    <style name="FinalTeam"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:gravity">center</item><item name="android:padding">8dp</item><item name="android:textColor">@color/white</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="PodiumCard"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_margin">4dp</item><item name="android:background">@drawable/bg_card</item><item name="android:gravity">center</item><item name="android:orientation">vertical</item><item name="android:padding">10dp</item></style>
    <style name="PodiumLeader" parent="PodiumCard"><item name="android:layout_height">158dp</item><item name="android:background">@drawable/bg_leader_card</item></style>
    <style name="PodiumTeam"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">8dp</item><item name="android:gravity">center</item><item name="android:maxLines">2</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item></style>
    <style name="PodiumPoints"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">5dp</item><item name="android:gravity">center</item><item name="android:textColor">@color/blue</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item></style>
    <style name="TableHeaderRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">46dp</item><item name="android:background">@color/blue_light</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item></style>
    <style name="TableRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">62dp</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item></style>
    <style name="RankCell"><item name="android:layout_width">48dp</item><item name="android:layout_height">match_parent</item><item name="android:gravity">center</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item></style>
    <style name="TableTeamCell"><item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:layout_weight">1</item><item name="android:gravity">center_vertical</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item></style>
    <style name="TableTeamCellHeader" parent="TableTeamCell"><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">11sp</item></style>
    <style name="TableCell"><item name="android:layout_width">54dp</item><item name="android:layout_height">match_parent</item><item name="android:gravity">center</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">13sp</item></style>
    <style name="TableCellHeader" parent="TableCell"><item name="android:textSize">11sp</item><item name="android:textStyle">bold</item></style>
    <style name="TablePoints" parent="TableCell"><item name="android:textColor">@color/blue</item><item name="android:textStyle">bold</item></style>
    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
