<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/actions_title" />
                <TextView style="@style/SmallBadge" android:background="@drawable/bg_badge_blue" android:text="@string/actions_official" android:textColor="@color/blue" />
            </LinearLayout>
            <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="14dp" android:text="@string/actions_subtitle" />

            <LinearLayout android:id="@+id/action_register" style="@style/OperationCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_edit_button" android:gravity="center" android:text="📝" android:textSize="20sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_register" android:textColor="@color/text_primary" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/action_register_description" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="48dp" android:gravity="center" android:text="›" android:textColor="@color/text_secondary" android:textSize="22sp" />
                </LinearLayout>
                <TextView style="@style/SmallBadge" android:layout_marginTop="8dp" android:background="@drawable/bg_badge_green" android:text="@string/status_registration" android:textColor="@color/green" />
            </LinearLayout>

            <LinearLayout android:id="@+id/action_bracket" style="@style/OperationCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_badge_yellow" android:gravity="center" android:text="🏆" android:textSize="20sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_bracket" android:textColor="@color/text_primary" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/action_bracket_description" android:textColor="@color/text_secondary" android:textSize="11sp" /></LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="48dp" android:gravity="center" android:text="›" android:textColor="@color/text_secondary" android:textSize="22sp" />
                </LinearLayout>
                <TextView style="@style/SmallBadge" android:layout_marginTop="8dp" android:background="@drawable/bg_badge_yellow" android:text="@string/status_progress" android:textColor="#B45309" />
            </LinearLayout>

            <LinearLayout android:id="@+id/action_live" style="@style/OperationCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_badge_red" android:gravity="center" android:text="🔴" android:textSize="20sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_live" android:textColor="@color/text_primary" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/action_live_description" android:textColor="@color/text_secondary" android:textSize="11sp" /></LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="48dp" android:gravity="center" android:text="›" android:textColor="@color/text_secondary" android:textSize="22sp" />
                </LinearLayout>
                <TextView style="@style/SmallBadge" android:layout_marginTop="8dp" android:background="@drawable/bg_badge_red" android:text="@string/status_live" android:textColor="#E11D48" />
            </LinearLayout>

            <LinearLayout android:id="@+id/action_standings" style="@style/OperationCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_edit_button" android:gravity="center" android:text="📊" android:textSize="20sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_standings" android:textColor="@color/text_primary" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/action_standings_description" android:textColor="@color/text_secondary" android:textSize="11sp" /></LinearLayout>
                    <TextView android:layout_width="24dp" android:layout_height="48dp" android:gravity="center" android:text="›" android:textColor="@color/text_secondary" android:textSize="22sp" />
                </LinearLayout>
                <TextView style="@style/SmallBadge" android:layout_marginTop="8dp" android:background="@drawable/bg_badge_blue" android:text="@string/status_week" android:textColor="@color/blue" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/actions_footer" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView style="@style/SmallBadge" android:background="@drawable/bg_badge_blue" android:text="@string/actions_teams" android:textColor="@color/blue" />
    </LinearLayout>
</LinearLayout>
